<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="co.com.bancolombia.kabrilla.controller.ConfigMapContentController"
            stylesheets="@../css/demo.css"
            styleClass="anchorPane">

    <!-- Scroll general -->
    <ScrollPane fitToWidth="true"
                fitToHeight="true"
                AnchorPane.topAnchor="0.0"
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                style="-fx-background-color: #2B2B2B;">
        <content>
            <VBox spacing="15" style="-fx-background-color: #2B2B2B;">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>


                <!-- Header -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="ConfigMaps"
                           style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                    <Button text="⟳ Refresh"
                            style="-fx-background-color: transparent; -fx-text-fill: #1EBFF2; -fx-font-size: 14px;"/>
                </HBox>

                <!-- Contenedor de las cards -->
                <FlowPane fx:id="configMapContainer"
                          hgap="15"
                          vgap="15"
                          prefWrapLength="1000"
                          style="-fx-background-color: #2B2B2B;">

                    <!-- Ejemplo de una card -->
                    <VBox prefWidth="300"
                          spacing="8"
                          style="-fx-background-color: #3C3F41; -fx-background-radius: 10; -fx-padding: 15;">

                        <HBox spacing="5">
                            <Label text="Name:" style="-fx-text-fill: #A9B7C6;"/>
                            <Label text="app-config" style="-fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
                        </HBox>

                        <HBox spacing="5">
                            <Label text="Namespace:" style="-fx-text-fill: #A9B7C6;"/>
                            <Label text="xyz-namespace" style="-fx-text-fill: #FFFFFF;"/>
                        </HBox>

                        <HBox spacing="5">
                            <Label text="Created:" style="-fx-text-fill: #A9B7C6;"/>
                            <Label text="2025-10-26 10:45" style="-fx-text-fill: #FFFFFF;"/>
                        </HBox>

                        <Label text="Data:"
                               style="-fx-text-fill: #A9B7C6; -fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>

                        <VBox spacing="4"
                              style="-fx-background-color: #4E5254; -fx-background-radius: 6; -fx-padding: 8;">
                            <HBox spacing="8">
                                <Label text="DATABASE_URL:" style="-fx-text-fill: #1EBFF2; -fx-font-family: Consolas;"/>
                                <Label text="jdbc:postgresql://db.internal:5432/mydb"
                                       style="-fx-text-fill: #FFFFFF; -fx-font-family: Consolas;"/>
                            </HBox>
                            <HBox spacing="8">
                                <Label text="LOG_LEVEL:" style="-fx-text-fill: #1EBFF2; -fx-font-family: Consolas;"/>
                                <Label text="DEBUG"
                                       style="-fx-text-fill: #FFFFFF; -fx-font-family: Consolas;"/>
                            </HBox>
                        </VBox>
                    </VBox>

                </FlowPane>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
