<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="co.com.bancolombia.kabrilla.controller.HpaContentController"
            stylesheets="@../css/demo.css"
            styleClass="anchorPane">

    <VBox spacing="15"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          style="-fx-background-color:#2B2B2B;">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20"/>
        </padding>

        <!-- Header -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Horizontal Pod Autoscaler"
                   style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;"/>
            <Button text="⟳ Refresh"
                    style="-fx-background-color:transparent; -fx-text-fill:#1EBFF2;"/>
        </HBox>

        <!-- Summary cards -->
        <HBox spacing="15">
            <VBox spacing="5" alignment="CENTER"
                  style="-fx-background-color:#3C3F41; -fx-background-radius:10; -fx-padding:10;"
                  prefWidth="180">
                <Label text="Current Replicas"
                       style="-fx-text-fill:#A9B7C6; -fx-font-size:12px;"/>
                <Label fx:id="currentReplicasLabel"
                       text="3"
                       style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER"
                  style="-fx-background-color:#3C3F41; -fx-background-radius:10; -fx-padding:10;"
                  prefWidth="180">
                <Label text="Desired Replicas"
                       style="-fx-text-fill:#A9B7C6; -fx-font-size:12px;"/>
                <Label fx:id="desiredReplicasLabel"
                       text="5"
                       style="-fx-text-fill:#1EBFF2; -fx-font-size:20px; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER"
                  style="-fx-background-color:#3C3F41; -fx-background-radius:10; -fx-padding:10;"
                  prefWidth="180">
                <Label text="Target CPU Utilization"
                       style="-fx-text-fill:#A9B7C6; -fx-font-size:12px;"/>
                <Label fx:id="targetCpuLabel"
                       text="70%"
                       style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>
            </VBox>

            <VBox spacing="5" alignment="CENTER"
                  style="-fx-background-color:#3C3F41; -fx-background-radius:10; -fx-padding:10;"
                  prefWidth="180">
                <Label text="Current CPU Utilization"
                       style="-fx-text-fill:#A9B7C6; -fx-font-size:12px;"/>
                <Label fx:id="currentCpuLabel"
                       text="58%"
                       style="-fx-text-fill:#1EBFF2; -fx-font-size:20px; -fx-font-weight:bold;"/>
            </VBox>
        </HBox>

        <!-- Table of pods -->
        <TableView fx:id="metricsTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color:#3C3F41; -fx-table-cell-border-color:#4E5254; -fx-border-radius:10;">
            <columns>
                <TableColumn text="Pod" prefWidth="250"/>
                <TableColumn text="CPU %" prefWidth="100"/>
                <TableColumn text="Memory (MiB)" prefWidth="150"/>
                <TableColumn text="Restarts" prefWidth="80"/>
                <TableColumn text="Age" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
