<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<HBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
      fx:controller="co.com.bancolombia.kabrilla.ui.controller.StatusBarController"
      styleClass="kb-status-bar" spacing="18" alignment="CENTER_LEFT">
    <padding>
        <Insets top="2" right="10" bottom="2" left="10"/>
    </padding>

    <Label fx:id="userLabel" styleClass="kb-status-item"/>
    <Label fx:id="contextLabel" styleClass="kb-status-item"/>
    <Pane HBox.hgrow="ALWAYS"/>
    <Button fx:id="terminalButton" text="&gt;_ Terminal" onAction="#onToggleTerminal" styleClass="kb-status-button">
        <tooltip>
            <Tooltip text="Mostrar u ocultar el panel de terminal (Ctrl+ñ o Ctrl+`)"/>
        </tooltip>
    </Button>
    <Label fx:id="versionLabel" styleClass="kb-status-item"/>
</HBox>
