               <Button fx:id="btnAddKubePath" layoutX="350.0" layoutY="114.0" onAction="#onAddKubePathClick" text="Agregar kubectl" />
               <Button fx:id="btnAddNameSpace" layoutX="54.0" layoutY="114.0" onAction="#onAddNameSpaceClick" text="Agregar kubectl" />
