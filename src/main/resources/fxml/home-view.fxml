            <Label fx:id="welcomeText" text="Bienvenido" textFill="WHITE" />
         <AnchorPane prefHeight="459.0" prefWidth="830.0" style="-fx-background-color: #949797;">
            <children>
               <TextField fx:id="txtKubePath" layoutX="350.0" layoutY="68.0" prefHeight="25.0" prefWidth="239.0" />
