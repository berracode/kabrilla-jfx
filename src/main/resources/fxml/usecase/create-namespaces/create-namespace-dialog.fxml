<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ButtonType?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<DialogPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
            fx:id="dialogPane" prefWidth="420"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.usecases.CreateNamespaceController">
    <content>
        <VBox spacing="14">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="Registrar namespace" styleClass="kb-title"/>
            <GridPane hgap="12" vgap="10">
                <Label text="Cluster" styleClass="kb-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="clusterComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1"
                          promptText="Selecciona un cluster" prefWidth="260"/>
                <Label text="Namespace" styleClass="kb-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="namespaceField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           promptText="Ej: my-app-namespace"/>
            </GridPane>
        </VBox>
    </content>
    <buttonTypes>
        <ButtonType fx:id="okButton" text="Crear" buttonData="OK_DONE"/>
        <ButtonType fx:id="cancelButton" text="Cancelar" buttonData="CANCEL_CLOSE"/>
    </buttonTypes>
</DialogPane>
