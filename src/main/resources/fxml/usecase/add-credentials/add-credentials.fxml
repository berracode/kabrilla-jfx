<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
      fx:controller="co.com.bancolombia.kabrilla.ui.controller.usecases.AddCredentialsController"
      spacing="14" maxWidth="720" styleClass="kb-page">
    <padding>
        <Insets top="20" left="20" right="20" bottom="20"/>
    </padding>

    <Label text="Credenciales AWS por cluster" styleClass="kb-title"/>
    <Label wrapText="true" styleClass="kb-muted"
           text="Pega el bloque de credenciales temporales (aws_access_key_id, aws_secret_access_key, aws_session_token)."/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Cluster" styleClass="kb-field-label"/>
        <ComboBox fx:id="clusterComboBox" promptText="Selecciona un cluster" prefWidth="280"/>
    </HBox>

    <TextArea fx:id="credentialsArea" promptText="Pega aquí tus credenciales AWS"
              prefRowCount="8" wrapText="true" styleClass="kb-mono"/>

    <HBox>
        <Button text="Guardar credenciales" fx:id="saveButton" onAction="#handleSave" styleClass="kb-primary"/>
    </HBox>
</VBox>
