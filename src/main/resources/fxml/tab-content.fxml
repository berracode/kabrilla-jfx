<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="10" xmlns="http://javafx.com/javafx/23.0.1"
      fx:controller="co.com.bancolombia.kabrilla.controller.TabContentController"
      stylesheets="@../css/styles.css"
>
    <HBox spacing="10">
        <Button text="pods"/>
        <Button text="Logs"/>
        <Button text="Config map"/>
        <Button text="RequestPolicy"/>
        <Button text="Service" styleClass="button"/>
    </HBox>
    <ComboBox fx:id="comboBox"/>
    <TextArea fx:id="logsArea" editable="false"/>
    <padding>
        <Insets bottom="2.0" left="2.0" right="2.0" top="2.0"/>
    </padding>
</VBox>
