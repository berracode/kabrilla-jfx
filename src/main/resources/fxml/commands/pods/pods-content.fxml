<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.commands.PodsContentController"
            styleClass="kb-page">
    <VBox spacing="10" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <padding>
            <Insets top="12" right="12" bottom="12" left="12"/>
        </padding>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Pods" styleClass="kb-title"/>
            <Button text="Refrescar" onAction="#onRefreshClicked" styleClass="kb-ghost"/>
        </HBox>
        <!-- Las columnas se crean en PodsContentController -->
        <TableView fx:id="podsTable" VBox.vgrow="ALWAYS"/>
    </VBox>
</AnchorPane>
