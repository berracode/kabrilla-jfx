<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.commands.PodsContentController"
            stylesheets="@../../../css/demo.css"
            styleClass="anchorPaneDebug">

    <VBox spacing="8" AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          style="-fx-background-color:#2B2B2B;">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Pods"
                   style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;"/>
            <Button text="⟳ Refresh" onAction="#onRefreshClicked" style="-fx-background-color:transparent; -fx-text-fill:#1EBFF2;"/>
        </HBox>

        <TableView fx:id="podsTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color:#3C3F41; -fx-table-cell-border-color:#4E5254;">
            <columns>
                <TableColumn text="Name" prefWidth="240"/>
                <TableColumn text="Status" prefWidth="100"/>
                <TableColumn text="Restarts" prefWidth="80"/>
                <TableColumn text="Age" prefWidth="80"/>
                <TableColumn text="Node" prefWidth="180"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
