<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.fxmisc.flowless.VirtualizedScrollPane?>
<?import org.fxmisc.richtext.StyleClassedTextArea?>
<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1"
      styleClass="kb-page" prefHeight="650.0" prefWidth="1000.0" VBox.vgrow="ALWAYS"
      fx:controller="co.com.bancolombia.kabrilla.ui.controller.commands.LogsContentController">

    <!-- Barra de herramientas: stream, rango y filtro -->
    <VBox spacing="8" styleClass="kb-toolbar">
        <padding>
            <Insets top="10" right="12" bottom="10" left="12"/>
        </padding>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label styleClass="kb-field-label" text="Pod"/>
            <ComboBox fx:id="podCombo" prefWidth="380.0"/>
            <Label styleClass="kb-field-label" text="Container"/>
            <ComboBox fx:id="containerCombo" prefWidth="200.0"/>
            <Button onAction="#onRefreshPodsClicked" text="Refrescar pods" styleClass="kb-ghost"/>

            <Pane HBox.hgrow="ALWAYS"/>
            <ProgressIndicator fx:id="progressFollowing" prefHeight="18" prefWidth="18" visible="false"/>
            <Button fx:id="btnToggleStream" onAction="#onToggleStreamClicked" prefWidth="95.0" styleClass="kb-primary"/>
            <Button onAction="#onClearClicked" text="Limpiar"/>
            <CheckBox fx:id="autoScrollCheck" selected="true" text="Auto-scroll"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label styleClass="kb-field-label" text="Rango"/>
            <ComboBox fx:id="rangeCombo" prefWidth="160.0"/>
            <HBox fx:id="customRangeBox" spacing="6" alignment="CENTER_LEFT">
                <Label styleClass="kb-field-label" text="Desde"/>
                <DatePicker fx:id="fromDate" prefWidth="125.0"/>
                <TextField fx:id="fromTime" prefColumnCount="4" promptText="HH:mm"/>
                <Label styleClass="kb-field-label" text="Hasta"/>
                <DatePicker fx:id="toDate" prefWidth="125.0"/>
                <TextField fx:id="toTime" prefColumnCount="4" promptText="HH:mm"/>
            </HBox>
            <CheckBox fx:id="previousCheck" text="Container anterior"/>
            <Button fx:id="queryButton" onAction="#onQueryClicked" text="Consultar" styleClass="kb-primary"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label styleClass="kb-field-label" text="Buscar"/>
            <TextField fx:id="txtSearch" promptText="Texto a buscar (filtra y resalta)" HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="regexCheck" text="Regex"/>
            <CheckBox fx:id="caseSensitiveCheck" text="Mayús/minús"/>
            <Separator orientation="VERTICAL"/>
            <Label styleClass="kb-field-label" text="Nivel mínimo"/>
            <ComboBox fx:id="levelCombo" prefWidth="100.0"/>
            <Label fx:id="matchCountLabel" minWidth="170" styleClass="kb-muted"/>
        </HBox>
    </VBox>

    <VirtualizedScrollPane VBox.vgrow="ALWAYS" minWidth="800">
        <content>
            <StyleClassedTextArea fx:id="txtLogArea" styleClass="kb-log-area" prefHeight="650.0" prefWidth="1000.0">
                <padding>
                    <Insets top="6" right="8" bottom="6" left="8"/>
                </padding>
            </StyleClassedTextArea>
        </content>
    </VirtualizedScrollPane>

    <!-- Barra de estado: errores e información de la consulta -->
    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="kb-statusbar">
        <padding>
            <Insets top="6" right="12" bottom="6" left="12"/>
        </padding>
        <Label fx:id="errorLabel" styleClass="kb-error"/>
        <Label fx:id="infoLabel" wrapText="true" styleClass="kb-muted"/>
    </HBox>
</VBox>
