<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.commands.AuthorizationPolicyContentController"
            stylesheets="@../../../css/demo.css"
            styleClass="anchorPane">

    <VBox spacing="10"
          AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          style="-fx-background-color:#2B2B2B;">

        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <Label text="Authorization Policy"
               style="-fx-text-fill:white; -fx-font-size:18px; -fx-font-weight:bold;"/>

        <GridPane hgap="10" vgap="6"
                  style="-fx-background-color:#3C3F41; -fx-background-radius:10; -fx-padding:15;">
            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-text-fill:#A9B7C6;"/>
            <Label fx:id="nameLabel" text="auth-policy-dev" GridPane.rowIndex="0" GridPane.columnIndex="1"
                   style="-fx-text-fill:white;"/>

            <Label text="Namespace:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-text-fill:#A9B7C6;"/>
            <Label fx:id="namespaceLabel" text="xyz-1-dev" GridPane.rowIndex="1" GridPane.columnIndex="1"
                   style="-fx-text-fill:white;"/>

            <Label text="Action:" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-text-fill:#A9B7C6;"/>
            <Label fx:id="actionLabel" text="ALLOW" GridPane.rowIndex="2" GridPane.columnIndex="1"
                   style="-fx-text-fill:#1EBFF2; -fx-font-weight:bold;"/>

            <Label text="Rules:" GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-text-fill:#A9B7C6; -fx-font-weight:bold;"/>

            <TextArea fx:id="rulesArea" editable="false" wrapText="false" GridPane.rowIndex="3" GridPane.columnIndex="1"
                      style="-fx-control-inner-background:#4E5254; -fx-text-fill:#FFFFFF;
                             -fx-font-family:Consolas; -fx-font-size:13px; -fx-background-radius:6;"
                      prefRowCount="8">
                <text>
                    - from:
                    - source:
                    principals: ["cluster.local/ns/xyz-1-dev/sa/frontend"]
                    - to:
                    - operation:
                    methods: ["GET", "POST"]
                    paths: ["/api/*"]
                </text>
            </TextArea>
        </GridPane>

    </VBox>
</AnchorPane>
