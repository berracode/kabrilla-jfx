<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.com.bancolombia.kabrilla.ui.controller.debug.StateDebugController"
      spacing="20" styleClass="kb-statusbar">
    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <VBox spacing="8">
        <Label text="Estado actual" styleClass="kb-section-title"/>
        <Label fx:id="clusterText"/>
        <Label fx:id="namespaceText"/>
        <Label fx:id="deploymentText"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Credenciales" styleClass="kb-section-title"/>
        <ListView fx:id="credentialsListView" prefWidth="400" prefHeight="200"/>
    </VBox>

    <VBox spacing="8">
        <Label text="KubeConfig" styleClass="kb-section-title"/>
        <ListView fx:id="kubeConfigListView" prefWidth="400" prefHeight="200"/>
    </VBox>
</HBox>
