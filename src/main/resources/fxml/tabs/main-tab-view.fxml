<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.tabs.MainTabController" minHeight="0.0"
            fx:id="mainContent" minWidth="0.0" prefHeight="160.0" prefWidth="100.0"
            styleClass="kb-page">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <children>
            <TabPane fx:id="deploymentTabPane" styleClass="kb-deployment-tabs" tabClosingPolicy="SELECTED_TAB"
                     VBox.vgrow="ALWAYS"/>
        </children>
    </VBox>
</AnchorPane>
