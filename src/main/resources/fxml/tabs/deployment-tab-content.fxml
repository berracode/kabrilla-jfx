<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.tabs.DeploymentTabController"
            styleClass="kb-page">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <!-- TabPane de comandos -->
        <TabPane fx:id="commandTabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab text="Logs"/>
            <Tab text="Pods"/>
            <Tab text="HPA"/>
            <Tab text="ConfigMap"/>
            <Tab text="RequestAuthentication"/>
            <Tab text="AuthorizationPolicy"/>
            <Tab text="Service"/>
        </TabPane>
    </VBox>
</AnchorPane>
