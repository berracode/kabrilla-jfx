<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.com.bancolombia.kabrilla.ui.controller.tabs.DeploymentTabController"
            stylesheets="@../../css/demo.css"
            styleClass="anchorPane">

    <VBox layoutY="32.0" prefHeight="686.0" prefWidth="1002.0" spacing="4" style="-fx-background-color: #2B2B2B;"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="4">

        <!-- TabPane de comandos -->
        <TabPane fx:id="commandTabPane"
                 prefHeight="37.0" prefWidth="469.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <Tab style="-fx-pref-height: 37px;" text="Logs"/>
            <Tab style="-fx-pref-height: 37px;" text="Pods"/>
            <Tab style="-fx-pref-height: 37px;" text="HPA"/>
            <Tab style="-fx-pref-height: 37px;" text="ConfigMap"/>
            <Tab style="-fx-pref-height: 37px;" text="RequestAuthentication"/>
            <Tab style="-fx-pref-height: 37px;" text="AuthorizationPolicy"/>
            <Tab style="-fx-pref-height: 37px;" text="Service"/>
        </TabPane>
    </VBox>
</AnchorPane>