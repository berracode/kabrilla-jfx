<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.*?>
<SplitPane xmlns:fx="http://javafx.com/fxml/1" dividerPositions="0.21590909090909086" maxHeight="-Infinity"
           maxWidth="-Infinity"
           minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0"
           styleClass="main2-split-pane" stylesheets="@../../css/demo.css" xmlns="http://javafx.com/javafx/25">
    <!-- Sidebar con TreeView -->
    <VBox prefHeight="397.0" prefWidth="126.0" styleClass="vbox"/>
    <!-- FIN Sidebar con TreeView -->

    <!-- Main area -->
    <AnchorPane fx:id="mainContent"
                styleClass="anchorPane"
                style="-fx-background-color: blue;" visible="true">
        <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
              VBox.vgrow="ALWAYS"
              style="-fx-background-color: white;">

            <children>
                <TabPane fx:id="deploymentTabPane" tabClosingPolicy="UNAVAILABLE" visible="true">

                    <!-- TABs area -->

                    <Tab text="Tab 1">
                        <!-- tab content -->

                        <BorderPane>
                            <top>
                                <!-- TabPane de comandos -->
                                <TabPane fx:id="commandTabPane"
                                         prefHeight="37.0" prefWidth="469.0" tabClosingPolicy="UNAVAILABLE"
                                         style="-fx-background-color: #3c3f41;"
                                         visible="true"
                                >
                                    <Tab style="-fx-pref-height: 37px;" text="Logs"/>
                                    <Tab style="-fx-pref-height: 37px;" text="Pods"/>
                                    <Tab style="-fx-pref-height: 37px;" text="ConfigMap"/>
                                    <Tab style="-fx-pref-height: 37px;" text="RequestPolicy"/>
                                    <Tab style="-fx-pref-height: 37px;" text="Service"/>
                                </TabPane>
                            </top>
                            <center>
                                <!-- Contenido dinamico command LOGS-CONTENT-->
                                <AnchorPane styleClass="anchorPane">

                                    <VBox VBox.vgrow="ALWAYS" spacing="4"
                                          style="-fx-background-color: #2B2B2B;"
                                    >

                                        <HBox prefHeight="50" prefWidth="200.0">
                                            <children>
                                                <ComboBox fx:id="comboBox" prefWidth="150.0"/>
                                            </children>
                                            <padding>
                                                <Insets left="10.0" right="10.0" top="10.0"/>
                                            </padding>
                                        </HBox>
                                        <VBox VBox.vgrow="ALWAYS">
                                            <children>
                                                <TextArea fx:id="logsArea" editable="false" VBox.vgrow="ALWAYS"/>
                                            </children>
                                            <padding>
                                                <Insets left="6.0" right="6.0"/>
                                            </padding>
                                            <!--                                                <VBox.margin>-->
                                            <!--                                                    <Insets bottom="100.0"/>-->
                                            <!--                                                </VBox.margin>-->
                                        </VBox>
                                    </VBox>
                                </AnchorPane>
                                <!-- FIN Contenido dinamico command-->
                            </center>
                        </BorderPane>

                        <!-- FIN tab content -->

                    </Tab>
                    <!--                    <Tab text="Tab 2">-->
                    <!--                        <ScrollPane>-->

                    <!--                        </ScrollPane>-->
                    <!--                    </Tab>-->

                    <!-- FIN TABs area -->

                </TabPane>
            </children>
        </VBox>
    </AnchorPane>
    <!-- Fin Main area -->

</SplitPane>
