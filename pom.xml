<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.com.bancolombia</groupId>
    <artifactId>kabrilla</artifactId>
    <!-- La versión la define el tag de git (vX.Y.Z) en el workflow de release: mvn -Drevision=X.Y.Z -->
    <version>${revision}</version>
    <name>kabrilla</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.boot.version>4.1.0</spring.boot.version>
        <lombok.version>1.18.42</lombok.version>
        <!-- Versión para builds locales; en release se sobrescribe con -Drevision (ver .github/workflows/release.yml) -->
        <revision>0.0.0-SNAPSHOT</revision>
        <!-- Nombre de la app empaquetada (carpeta, ejecutable y ventana de jpackage) -->
        <app.name>Kabrilla</app.name>

        <!-- Argumentos para javafx:run, combinables por perfil: -Pmock, -Pno-styles, -Pstyles (p. ej. -Pmock,no-styles) -->
        <kabrilla.args.profile></kabrilla.args.profile>
        <kabrilla.args.styles></kabrilla.args.styles>
        <javafx.args>${kabrilla.args.profile} ${kabrilla.args.styles}</javafx.args>

    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--        <dependency>-->
        <!--            <groupId>org.springframework.boot</groupId>-->
        <!--            <artifactId>spring-boot-starter-jdbc</artifactId>-->
        <!--        </dependency>-->


        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21.0.6</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21.0.6</version>
        </dependency>

        <dependency>
            <groupId>org.fxmisc.richtext</groupId>
            <artifactId>richtextfx</artifactId>
            <version>0.11.2</version>
        </dependency>

        <!-- Versión gestionada por el BOM de Spring Boot (evita choques con junit-platform) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.0</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.2</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>2.15.2</version> <!-- Verifica la última versión -->
        </dependency>

        <!-- https://mvnrepository.com/artifact/org.projectlombok/lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <!-- Solo en compilación: no debe ir dentro de la app empaquetada -->
            <scope>provided</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/io.kubernetes/client-java -->
        <dependency>
            <groupId>io.kubernetes</groupId>
            <artifactId>client-java</artifactId>
            <version>24.0.0</version>
        </dependency>


    </dependencies>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring.boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <resources>
            <!-- Sin filtrar: application.properties usa ${...} de Spring (p. ej. ${user.home}) que Maven no debe tocar -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>kabrilla-version.properties</exclude>
                </excludes>
            </resource>
            <!-- Filtrado: escribe ${project.version} (la del tag en releases) -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>kabrilla-version.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <!-- La versión por defecto de Maven (2.12.4) no soporta JUnit 5 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- Tests en classpath: con module-info JUnit no puede resolver las clases de test -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Default configuration for running with: mvn clean javafx:run -->
                        <id>default-cli</id>
                        <configuration>
                            <mainClass>co.com.bancolombia.kabrilla/co.com.bancolombia.kabrilla.startup.JavaFxApplication
                            </mainClass>
                            <launcher>app</launcher>
                            <jlinkZipName>app</jlinkZipName>
                            <jlinkImageName>app</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ./mvnw javafx:run -Pmock : app con datos simulados de mock-data/, sin AWS ni cluster -->
        <profile>
            <id>mock</id>
            <properties>
                <kabrilla.args.profile>--spring.profiles.active=mock</kabrilla.args.profile>
            </properties>
        </profile>
        <!-- ./mvnw javafx:run -Pno-styles : sin el tema oscuro, solo el tema base de JavaFX -->
        <profile>
            <id>no-styles</id>
            <properties>
                <kabrilla.args.styles>--kabrilla.ui.styles-enabled=false</kabrilla.args.styles>
            </properties>
        </profile>
        <!-- ./mvnw javafx:run -Pstyles : fuerza el tema oscuro (útil si se cambió el default en application.properties) -->
        <profile>
            <id>styles</id>
            <properties>
                <kabrilla.args.styles>--kabrilla.ui.styles-enabled=true</kabrilla.args.styles>
            </properties>
        </profile>

        <!--
          ./mvnw clean package -Pportable -Drevision=X.Y.Z
          Genera target/dist/Kabrilla/ (app-image de jpackage con su propio JRE: no requiere Java instalado).
          Se ejecuta en modo classpath (main-jar + MainApplication): module-info no aplica y el runtime incluye
          todos los módulos del JDK. Solo Windows (las dependencias de JavaFX se resuelven para el SO del build).
        -->
        <profile>
            <id>portable</id>
            <build>
                <plugins>
                    <!-- jpackage exige versión numérica (1.2.3): se extrae de ${revision} aunque traiga -beta.1 -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>parse-version</id>
                                <goals>
                                    <goal>parse-version</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Jar de la app + dependencias de runtime juntos en target/libs (entrada de jpackage) -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <version>3.4.2</version>
                        <configuration>
                            <outputDirectory>${project.build.directory}/libs</outputDirectory>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.8.1</version>
                        <executions>
                            <execution>
                                <id>copy-dependencies</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy-dependencies</goal>
                                </goals>
                                <configuration>
                                    <includeScope>runtime</includeScope>
                                    <outputDirectory>${project.build.directory}/libs</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--description</argument>
                                        <argument>Cliente de escritorio de Kubernetes para logs</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.basedir}/src/main/resources/images/kabrilla-icon.ico</argument>

                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/libs</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>co.com.bancolombia.kabrilla.startup.MainApplication</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>

                                        <!-- Kabrilla.exe sin consola (logs en ~/.kabrilla/logs). Kabrilla-console.exe
                                             = mismo programa con consola, para diagnóstico/soporte -->
                                        <argument>--add-launcher</argument>
                                        <argument>${app.name}-console=${project.basedir}/src/main/jpackage/kabrilla-console.properties</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Xms64m -Xmx768m -XX:+UseSerialGC -Dfile.encoding=UTF-8</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>